<h1>Movies</h1>

<% if @movies.any? %>
  <ul class="movie-list">
    <% @movies.each do |movie| %>
      <li class="card movie-card">
        <div class="movie-main">
          <%= link_to movie.title, movie_path(movie), class: "movie-title" %>
          <span class="movie-meta"><%= [ movie.year, movie.director ].compact.join(" · ") %></span>
        </div>
        <div class="movie-rating">
          <span class="stars" title="<%= format_rating(movie.average_rating) %> / 5"><%= render_stars(movie.average_rating) %></span>
          <span class="rating-num"><%= format_rating(movie.average_rating) %></span>
          <span class="review-count">(<%= pluralize(movie.review_count, "review") %>)</span>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty">No movies yet. Run <code>bin/rails data:import</code> to load the CSVs.</p>
<% end %>
