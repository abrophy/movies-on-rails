<p class="mb-2 text-sm"><%= link_to "← Search actors", actors_path, class: "text-blue-600 hover:underline" %></p>

<h1 class="mb-6 text-2xl font-bold"><%= @actor.name %></h1>

<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
  <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="mb-2 font-semibold">Movies</h2>
    <ul class="space-y-1">
      <% @movies.each do |movie| %>
        <li><%= link_to movie.title, movie_path(movie), class: "text-blue-600 hover:underline" %> <span class="text-slate-400">(<%= movie.year %>)</span></li>
      <% end %>
    </ul>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="mb-2 font-semibold">Filming locations</h2>
    <ul class="space-y-1">
      <% @locations.each do |location| %>
        <li><%= link_to location.name, location_path(location), class: "text-blue-600 hover:underline" %> <span class="text-slate-400">(<%= location.country %>)</span></li>
      <% end %>
    </ul>
  </div>
</div>
