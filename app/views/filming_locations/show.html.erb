<p class="mb-2 text-sm"><%= link_to "← All movies", root_path, class: "text-blue-600 hover:underline" %></p>

<h1 class="mb-6 text-2xl font-bold"><%= @location.name %> <span class="font-normal text-slate-400">(<%= @location.country %>)</span></h1>

<div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="mb-2 font-semibold">Movies filmed here</h2>
  <% if @movies.any? %>
    <ul class="space-y-1">
      <% @movies.each do |movie| %>
        <li><%= link_to movie.title, movie_path(movie), class: "text-blue-600 hover:underline" %> <span class="text-slate-400">(<%= movie.year %>)</span></li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-slate-500">No movies recorded at this location.</p>
  <% end %>
</div>
